FROM dunglas/frankenphp:1.12.7-builder-php8.4-bookworm AS franken-builder

COPY --from=caddy:builder /usr/bin/xcaddy /usr/bin/xcaddy
COPY franken-tiered /src/franken-tiered

WORKDIR /go/src/app
RUN CGO_ENABLED=1 \
    XCADDY_SETCAP=1 \
    XCADDY_GO_BUILD_FLAGS="-ldflags='-w -s' -tags=nobadger,nomysql,nopgx" \
    CGO_CFLAGS="$(php-config --includes)" \
    CGO_LDFLAGS="$(php-config --ldflags) $(php-config --libs)" \
    xcaddy build \
        --output /usr/local/bin/frankenphp \
        --with github.com/dunglas/frankenphp=./ \
        --with github.com/dunglas/frankenphp/caddy=./caddy/ \
        --with github.com/b1tc0re/franken-tiered=/src/franken-tiered

FROM composer:2 AS composer
FROM dunglas/frankenphp:1.12.7-php8.4-bookworm

COPY --from=franken-builder /usr/local/bin/frankenphp /usr/local/bin/frankenphp

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        unzip \
    && install-php-extensions pcntl sockets opcache pdo_sqlite protobuf \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer /usr/bin/composer /usr/local/bin/composer

WORKDIR /app

# The official FrankenPHP image ships a default /app/public/index.php.
# Remove it so Composer can create a clean Laravel project at /app.
RUN rm -rf /app/* \
    && composer create-project laravel/laravel:^13.0 /app --prefer-dist --no-interaction \
    && composer require \
        laravel/octane:^2.17 \
        spiral/roadrunner-http:^3.3 \
        spiral/roadrunner-kv:^4.0 \
        predis/predis:^3.0 \
        --no-interaction \
    && composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction

COPY app/Support/BenchmarkStores.php /app/app/Support/BenchmarkStores.php
COPY app/Support/ProdLikePayload.php /app/app/Support/ProdLikePayload.php
COPY app/Cache /app/app/Cache
COPY app/Providers/AppServiceProvider.php /app/app/Providers/AppServiceProvider.php
COPY routes/web.php /app/routes/web.php
COPY php.ini /usr/local/etc/php/conf.d/99-benchmark.ini
COPY entrypoint-frankenphp.sh /usr/local/bin/benchmark-frankenphp-entrypoint

RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && chmod +x /usr/local/bin/benchmark-frankenphp-entrypoint \
    && mkdir -p /app/storage/framework/cache /app/storage/framework/sessions /app/storage/framework/views /app/storage/logs /app/bootstrap/cache

EXPOSE 8080

ENTRYPOINT ["benchmark-frankenphp-entrypoint"]