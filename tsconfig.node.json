{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {"#build/ui": ["node_modules/.nuxt-ui/ui"]}
  },
  "include": ["vite.config.ts", "vitest.config.ts", "postcss.config.mjs", ".storybook/**/*.ts"]
}
