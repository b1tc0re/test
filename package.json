{
  "name": "@dilexy/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Dilexy Vue 3 component library built on Nuxt UI.",
  "license": "MIT",
  "files": [
    "build/dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./button": {
      "types": "./build/dist/components/button/index.d.ts",
      "import": "./build/dist/components/button/index.js"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build -o build/storybook-static",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run stylelint && bun run typecheck && bun run test && bun run test:coverage && bun run build && bun run build:storybook",
    "pack": "bun pm pack --destination build/package"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.10.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@nuxt/ui": "4.10.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-themes": "10.5.3",
    "@storybook/vue3-vite": "10.5.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-sfc": "3.5.40",
    "autoprefixer": "10.4.21",
    "happy-dom": "20.11.1",
    "postcss": "8.5.6",
    "postcss-html": "1.8.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.93.3",
    "storybook": "10.5.3",
    "stylelint": "16.25.0",
    "stylelint-config-standard-scss": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.8"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  }
}
